      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TapMemo"
          }
        }
      }
    },
    "Tocca due volte e parla": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap and speak"
          }
        }
      }
    },
    "Tocca due volte per finire": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to finish"
          }
        }
      }
    },
    "Tocca e parla": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap and speak"
          }
        }
      }
    },
    "Tocca il cerchio e dì quando. TapMemo scrive il titolo e crea l'evento al posto tuo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the circle and say when. TapMemo writes the title and creates the event for you."
          }
        }
      }
    },
    "Tocca per finire · scorri giù per annullare": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to finish · swipe down to cancel"
          }
        }
      }
    },
    "Un attimo…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One moment…"
          }
        }
      }
    },
    "domani, %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tomorrow, %@"
          }
        }
      }
    },
    "domani, %@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tomorrow, %@ · %@"
          }
        }
      }
    },
    "dopodomani, sabato 25, stasera, a mezzogiorno.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the day after tomorrow, Saturday the 25th, tonight, at noon."
          }
        }
      }
    },
    "oggi, %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "today, %@"
          }
        }
      }
    },

    "Ho capito": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got it"
          }
        }
      }
    },
    "Il memo è salvato in TapMemo, ma l'evento non è stato creato. (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The memo is saved in TapMemo, but the event was not created. (%@)"
          }
        }
      }
    },
    "Il memo è salvato in TapMemo; il promemoria no. Autorizza Promemoria per completare l'operazione.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The memo is saved in TapMemo; the reminder is not. Allow Reminders to finish the job."
          }
        }
      }
    },
    "Il memo è salvato in TapMemo; l'evento no. Autorizza il calendario per far creare gli eventi a TapMemo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The memo is saved in TapMemo; the event is not. Allow calendar access so TapMemo can create events."
          }
        }
      }
    },
    "Il microfono è disattivato": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is off"
          }
        }
      }
    },
    "In Calendario": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Calendar"
          }
        }
      }
    },
    "In Promemoria": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Reminders"
          }
        }
      }
    },
    "L'evento collegato verrà rimosso anche dal Calendario.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The linked event will be removed from Calendar too."
          }
        }
      }
    },
    "Mantieni": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep"
          }
        }
      }
    },
    "Memo salvato in TapMemo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memo saved in TapMemo"
          }
        }
      }
    },
    "Metti in Calendario": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put it in Calendar"
          }
        }
      }
    },
    "Non ho capito": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I didn't catch that"
          }
        }
      }
    },
    "Non ho sentito niente di comprensibile. Nessun memo è stato creato: tocca e parla di nuovo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I heard nothing I could make sense of. No memo was created: tap and speak again."
          }
        }
      }
    },
    "Non ho sentito una data. Il memo è salvato: scorri per metterlo in Calendario.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I didn't hear a date. The memo is saved: swipe to put it in Calendar."
          }
        }
      }
    },
    "Non ora": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        }
      }
    },
    "Non riesco ad avviare la registrazione. Riprova fra un momento. (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't start recording. Try again in a moment. (%@)"
          }
        }
      }
    },
    "Nuova ora": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New time"
          }
        }
      }
    },
    "Parla, ed è in calendario.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak, and it's on your calendar."
          }
        }
      }
    },
    "Posso registrare, ma non trascrivere. La trascrizione avviene sul telefono: attivala per creare i memo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can record, but not transcribe. Transcription happens on your phone: turn it on to create memos."
          }
        }
      }
    },
    "Promemoria": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders"
          }
        }
      }
    },
    "Promemoria negati": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders access denied"
          }
        }
      }
    },
    "Prova a dire": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try saying"
          }
        }
      }
    },
    "Registra un memo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a memo"
          }
        }
      }
    },
    "Registrazione non disponibile": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording unavailable"
          }
        }
      }
    },
    "Senza microfono TapMemo non può ascoltarti. L'audio resta sul telefono: non viene registrato né inviato da nessuna parte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the microphone TapMemo can't hear you. Audio stays on your phone: it is never stored or sent anywhere."
          }
        }
      }
    },
    "Si chiude da sé fra %lld s": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes by itself in %lld s"
          }
        }
      }
    },
    "Solo in TapMemo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only in TapMemo"
          }
        }
      }
    },
    "Sto ascoltando": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening"
          }
        }
      }
    },
    "Sto capendo quando…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working out when…"
          }
        }
      }
    },
    "Sto creando il memo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating the memo"
          }
        }
      }
    },

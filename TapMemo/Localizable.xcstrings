          "stringUnit": {
            "state": "translated",
            "value": "“%@”"
          }
        }
      }
    },
    "«ricordami la spesa domani alle 3»": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“remind me to buy milk tomorrow at 3”"
          }

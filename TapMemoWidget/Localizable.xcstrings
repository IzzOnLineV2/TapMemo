{
  "sourceLanguage": "it",
  "strings": {
    "Apre TapMemo e avvia subito l'ascolto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens TapMemo and starts listening right away."
          }
        }
      }
    },
    "Avvia un memo vocale senza cercare l'app.": {
